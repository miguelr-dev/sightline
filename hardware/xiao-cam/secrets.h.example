// Copy to secrets.h (git-ignored) and fill in. Never commit secrets.h.
// ./hardware/flash.sh creates it for you and fills DEVICE_KEY from .env.local.

// The iPhone's Personal Hotspot (Maximize Compatibility on). The SSID is the iPhone's name.
#define WIFI_SSID "your-phone-hotspot"
#define WIFI_PASSWORD "hotspot-password"
// Optional backup network, e.g. a teammate's hotspot. Leave "" if none.
#define WIFI_SSID2 ""
#define WIFI_PASSWORD2 ""

// Leave SERVER_URL "" and the board finds the Mac by itself (saved last server, then mDNS, then a
// scan of the hotspot subnet for port 3000). Set it only to force one, e.g. "http://172.20.10.3:3000".
#define SERVER_URL ""
// The Mac's Bonjour name without ".local" (npm run demo:info prints it). Used for the mDNS step.
#define SERVER_HOST "your-mac-name"

#define DEVICE_ID "hat-01"
#define DEVICE_KEY "same-as-DEVICE_SHARED_KEY-on-the-server"

// Optional:
// #define FRAME_SIZE FRAMESIZE_XGA   // sharper small print, bigger uploads (default SVGA 800x600)
// #define FLIP_IMAGE 1               // camera mounted upside down
// #define MIRROR_IMAGE 1             // text reads backwards in the preview
// #define TORCH 1                    // keep the white flash LEDs on in a dark room
