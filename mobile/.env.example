# Where the SightLine Next.js server is. No trailing slash. Restart `npx expo start --clear` after changing it.
# Default: the live site on Vercel (also used when this is empty), which has every key set.
EXPO_PUBLIC_API_URL=https://sightline-theta-drab.vercel.app
# Local dev instead: your Mac's LAN IP, with `npm run dev -- -H 0.0.0.0` running at the repo root.
# EXPO_PUBLIC_API_URL=http://100.64.19.59:3000
