# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: model for reading photos. Defaults to claude-haiku-5-5 (fastest that reads text
# accurately in our tests). claude-sonnet-5-5 or claude-opus-5-5 also work.
ANTHROPIC_MODEL=
# Optional: model for web-lookup summaries and auto-capture frame checks. Defaults to claude-haiku-5-5.
ANTHROPIC_FAST_MODEL=

# --- ElevenLabs voice (optional) ---
# Spoken answers use ElevenLabs when this is set, and the browser's own voice when it isn't
# (or when a request fails or the phone is offline). Also powers voice commands on browsers
# without speech recognition (iOS home-screen app) via Scribe speech-to-text.
# The key needs Text to Speech and Speech to Text access.
ELEVENLABS_API_KEY=
# Optional: voice to use. Defaults to "Matilda" (XrExE9yKIg1WjnnlVkGX), an ElevenLabs default voice.
ELEVENLABS_VOICE_ID=
# Optional: text-to-speech model. Defaults to eleven_flash_v2_5 (low latency, all SightLine languages).
ELEVENLABS_MODEL_ID=
# Optional: speech-to-text model. Defaults to scribe_v3 (falls back to scribe_v2).
ELEVENLABS_STT_MODEL_ID=

# --- Bright Data web lookup (optional) ---
# When a photo shows a specific product, medicine, restaurant, book or place, SightLine searches
# Google through Bright Data's SERP API (recalls, nutrition, reviews, hours) and reads a short
# summary after the first answer. Leave these empty to turn the web lookup off.
BRIGHTDATA_API_KEY=
# The name of your SERP API zone in the Bright Data control panel, for example serp_api1.
BRIGHTDATA_SERP_ZONE=

# --- Neon Postgres (optional) ---
# Caches web lookups and repeat photos (answers in about 150 ms instead of seconds) and keeps a
# per-device scan history (text and web image URLs only, never photos). Use the pooled
# connection string from the Neon console. Tables are created on first use, or run npm run db:setup.
DATABASE_URL=

# --- Hat camera (optional) ---
# Shared secret the XIAO ESP32S3 hat sends as x-device-key. Generate one with: openssl rand -hex 24
# Also used to derive each hat's pair code (npm run device:code -- hat-01). Needs DATABASE_URL.
DEVICE_SHARED_KEY=
